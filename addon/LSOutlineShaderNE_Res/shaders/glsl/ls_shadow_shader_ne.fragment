// __multiversion__
precision highp float;
// =============================================================================
// Outline Shader - NetEase Minecraft (China) Edition port
// Screen-space shadow pass: localised ambient occlusion ("遮蔽光").
//
// NetEase's post-process exposes scene colour + perspective depth only (no
// shadow map, no lightmap).  This pass therefore builds a *localised* ambient
// occlusion from the depth buffer:
//
//   * it darkens ONLY pixels that have closer neighbours -- block step crevices,
//     block bottom corners, tree-trunk bases, under canopies,
//   * flat / open ground and lit faces are left untouched, so the image is NOT
//     darkened overall,
//   * no normals, no N.L, no sun march -> no moire, no sun dependence,
//   * high penumbra threshold -> thin grass / leaves are ignored, so no grass
//     "ghost" copies and no random patches.
//
// Engine facts (verified against the shipped vanilla_netease shaders):
//   * TEXTURE_2 is perspective depth; engine conversion is
//       viewZ = (f*n)/(f - z*(f-n)), n = 0.025, f = FAR_CHUNKS_DISTANCE
//
// Uniform mapping (set from Python by LSOutlineShaderNEClient.py):
//   EXTRA_VECTOR1 = (ENABLE_SHADOWS, SHADOW_BRIGHTNESS, SHADOW_DISTANCE, SOFT_SHADOWS)
//   EXTRA_VECTOR2 = (shadowMapResolution, BLOCK_LIGHT_INTENSITY,
//                    BLOCK_LIGHT_SHADOW_BOOST, Shininess)
// =============================================================================
#include "fragmentVersionCentroidUV.h"
#include "uniformPerFrameConstants.h"
#include "uniformWorldConstants.h"
#include "uniformShaderConstants.h"

LAYOUT_BINDING(0) uniform sampler2D TEXTURE_0; // scene colour
LAYOUT_BINDING(1) uniform sampler2D TEXTURE_1; // untouched scene colour
LAYOUT_BINDING(2) uniform sampler2D TEXTURE_2; // scene depth

uniform vec4 EXTRA_VECTOR1;
uniform vec4 EXTRA_VECTOR2;

const float NEAR_PLANE = 0.025;
// Colour a fully-occluded surface is multiplied by when SHADOW_BRIGHTNESS = 0.
const vec3 SHADOW_TINT = vec3(0.34, 0.40, 0.56);

// Perspective depth [0,1] -> view distance (blocks).
float depthToViewDist(float d)
{
    float f = max(FAR_CHUNKS_DISTANCE, 16.0);
    return (f * NEAR_PLANE) / max(f - d * (f - NEAR_PLANE), 1e-4);
}

float viewDistance(vec2 coord)
{
    return depthToViewDist(texture2D(TEXTURE_2, coord).r);
}

void main()
{
    vec2 screenSize = vec2(
        1.0 / max(abs(dFdx(uv.x)), 1e-6),
        1.0 / max(abs(dFdy(uv.y)), 1e-6));
    vec2 texel = 1.0 / max(screenSize, vec2(2.0));

    vec4 color = texture2D(TEXTURE_0, uv);

    float enable = EXTRA_VECTOR1.x;
    float shadowBrightness = clamp(EXTRA_VECTOR1.y, 0.0, 1.0);
    float shadowDistance = EXTRA_VECTOR1.z;
    float softShadows = EXTRA_VECTOR1.w;
    float resolution = max(EXTRA_VECTOR2.x, 512.0);
    float blockLightIntensity = max(EXTRA_VECTOR2.y, 0.0);
    float blockLightBoost = max(EXTRA_VECTOR2.z, 1.0);
    float shininess = clamp(EXTRA_VECTOR2.w, 0.0, 1.0);

    float occlusion = 0.0;

    if (enable > 0.5)
    {
        float farDistance = max(FAR_CHUNKS_DISTANCE, 16.0);
        float center = viewDistance(uv);

        // Sky / far plane: never shadowed.
        if (center < farDistance * 0.995)
        {
            float soft = step(0.5, softShadows);

            // Large radius so the occlusion spreads around trunks / under
            // canopies; the high penumbra threshold makes thin grass / leaves
            // irrelevant, which keeps the result clean.
            float radius = mix(40.0, 56.0, soft);
            int samples = int(mix(12.0, 18.0, soft));
            samples += int(clamp(log2(max(resolution, 512.0) / 512.0), 0.0, 3.0));
            float penumbra = max(1.3, center * 0.045);

            float ao = 0.0;
            for (int i = 0; i < 24; i++)
            {
                if (i >= samples) break;
                float angle = float(i) * 2.39996323;
                float r = radius * sqrt((float(i) + 0.5) / float(samples));
                vec2 offset = vec2(cos(angle), sin(angle)) * r * texel;
                float neighbour = viewDistance(uv + offset);
                ao += smoothstep(0.0, penumbra, center - neighbour);
            }
            occlusion = smoothstep(0.0, 0.45, ao / float(samples));

            if (shadowDistance > 0.0)
            {
                occlusion *= 1.0 - smoothstep(shadowDistance * 0.70, shadowDistance, center);
            }
        }

        // Localised shadow only: pixels with occlusion == 0 are left untouched,
        // so the image does not get darker overall.
        vec3 shadowMul = mix(SHADOW_TINT, vec3(1.0), shadowBrightness);
        color.rgb *= mix(vec3(1.0), shadowMul, clamp(occlusion, 0.0, 1.0));

        // BLOCK_LIGHT_INTENSITY / BLOCK_LIGHT_SHADOW_BOOST.
        float luma = dot(color.rgb, vec3(0.299, 0.587, 0.114));
        float blockMask = smoothstep(0.55, 0.90, luma);
        float blockScale = blockLightIntensity * mix(1.0, blockLightBoost, clamp(occlusion, 0.0, 1.0));
        color.rgb *= mix(1.0, blockScale, blockMask);
    }

    // Shininess: water highlight (bright-pixel specular stand-in).
    if (shininess > 0.001)
    {
        float luma2 = dot(color.rgb, vec3(0.299, 0.587, 0.114));
        float spec = pow(clamp(luma2, 0.0, 1.0), 16.0);
        color.rgb += vec3(spec * shininess * 0.8);
    }

    gl_FragColor = color;
}
